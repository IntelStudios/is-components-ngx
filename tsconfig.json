{
  "compileOnSave": false,
  "angularCompilerOptions": {
    "strictTemplates": true,
  },
  "compilerOptions": {
    "strict": false,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": "./",
    "importHelpers": true,
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "es2020",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "target": "ES2022",
    "typeRoots": [
      "node_modules/@types"
    ],
    "paths": {
      "@intelstudios/select": [
        "dist/is-select"
      ],
      "@intelstudios/select/*": [
        "dist/is-select/*"
      ],
      "@intelstudios/froala": [
        "dist/is-froala"
      ],
      "@intelstudios/froala/*": [
        "dist/is-froala/*"
      ],
      "@intelstudios/core-ui": [
        "dist/is-core-ui"
      ],
      "@intelstudios/core-ui/*": [
        "dist/is-core-ui/*"
      ],
      "@intelstudios/datepicker": [
        "dist/is-datepicker"
      ],
      "@intelstudios/datepicker/*": [
        "dist/is-datepicker/*"
      ],
      "@intelstudios/select-tree": [
        "dist/is-select-tree"
      ],
      "@intelstudios/select-tree/*": [
        "dist/is-select-tree/*"
      ],
      "@intelstudios/timepicker": [
        "dist/is-timepicker"
      ],
      "@intelstudios/cron-editor": [
        "dist/is-cron-editor"
      ],
      "@intelstudios/cron-editor/*": [
        "dist/is-cron-editor/*"
      ],
      "@intelstudios/cdk": [
        "dist/is-cdk/is-cdk",
        "dist/is-cdk"
      ],
      "@intelstudios/modal": [
        "dist/is-modal"
      ]
    },
    "useDefineForClassFields": false
  }
}